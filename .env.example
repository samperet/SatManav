# Journey form email delivery (Vercel → Project → Settings → Environment Variables)
# Create a free key at https://resend.com/api-keys
RESEND_API_KEY=
# Where leads are sent (defaults to satmanavyogi@gmail.com)
LEAD_TO_EMAIL=satmanavyogi@gmail.com
# Sender. Use the Resend test sender until satmanavyogitattoos.com is verified in Resend,
# then switch to e.g. "Sat Manav Tattoos <journey@satmanavyogitattoos.com>".
LEAD_FROM_EMAIL=Sat Manav Website <onboarding@resend.dev>
