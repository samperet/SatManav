# Set these in Vercel → Project → Settings → Environment Variables.

# Admin dashboard (/admin) password. Changing it signs everyone out.
ADMIN_PASSWORD=

# Database: Neon Postgres created from Vercel → Storage. Vercel sets this itself;
# locally, run `vercel env pull` or paste the connection string from Storage → Neon → .env.local.
DATABASE_URL=

# Journey photos: the private "satmanav-photos" Blob store (Vercel → Storage). Vercel sets this itself.
BLOB_READ_WRITE_TOKEN=

# Optional: separate secret for admin sessions / anonymous visitor ids (defaults to one derived from DATABASE_URL).
# SESSION_SECRET=

# Lead + testimonial notification emails. Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Where notifications go (defaults to satmanavyogi@gmail.com)
LEAD_TO_EMAIL=satmanavyogi@gmail.com
# Sender. Use the Resend test sender until satmanavyogitattoos.com is verified in Resend.
LEAD_FROM_EMAIL=Sat Manav Website <onboarding@resend.dev>
