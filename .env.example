# Set these in Vercel → Project → Settings → Environment Variables.

# Admin dashboard (/admin) password. Changing it signs everyone out.
ADMIN_PASSWORD=

# Database (Supabase project "satmanav"): Project Settings → API Keys → secret key.
# Server-only; never expose it in the browser.
SUPABASE_SECRET_KEY=
# Optional; defaults to the satmanav project URL.
# SUPABASE_URL=https://awzphbubjvsrctmuqhoi.supabase.co

# Lead + testimonial notification emails. Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Where notifications go (defaults to satmanavyogi@gmail.com)
LEAD_TO_EMAIL=satmanavyogi@gmail.com
# Sender. Use the Resend test sender until satmanavyogitattoos.com is verified in Resend.
LEAD_FROM_EMAIL=Sat Manav Website <onboarding@resend.dev>
