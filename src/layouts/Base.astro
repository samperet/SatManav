---
import '../styles/global.css';
import { site, nav } from '../data/site';
import Ticker from '../components/Ticker.astro';
import Social from '../components/Social.astro';

interface Props { title?: string; image?: string; solidHeader?: boolean; }
const { title, image = '/og.jpg', solidHeader = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : 'Sat Manav Yogi Tattoos';
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const c = site.contact;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TattooParlor',
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: c.phone,
  email: c.email,
  image: new URL('/og.jpg', site.url).href,
  address: { '@type': 'PostalAddress', streetAddress: c.street, addressLocality: c.city, addressRegion: c.region, postalCode: c.postal, addressCountry: 'US' },
  sameAs: [site.social.instagram, site.social.facebook],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0303" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sat Manav Yogi Tattoos" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cinzel:wght@400;600&family=Roboto+Slab:wght@300;400;500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class:list={['site-header', { 'is-solid': solidHeader }]} data-header data-solid={solidHeader ? 'always' : undefined}>
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <img src="/images/brand/lotus-white.webp" alt="" width="40" height="40" />
          <span>{site.name}</span>
        </a>
        <button class="menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="nav" data-menu><span></span><span></span><span></span></button>
        <nav class="nav" id="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <a class="btn" href="/journey">Begin Your Spiritual Journey</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <Ticker />
    <footer class="site-footer">
      <div class="wrap cols">
        <img src="/images/brand/lotus-white.webp" alt="" width="110" height="112" loading="lazy" />
        <div>
          <h2>{site.name}</h2>
          <p>{c.street}<br />{c.city}, {c.region} {c.postal}</p>
          <p><a href={c.phoneHref}>{c.phone}</a></p>
          <p><a href={`mailto:${c.email}`}>{c.email}</a></p>
          <Social />
        </div>
      </div>
    </footer>
    <Ticker />

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
