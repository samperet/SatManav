---
import Base from '../layouts/Base.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Social from '../components/Social.astro';
import { gallery } from '../data/site';
---
<Base title="Gallery" solidHeader>
  <section class="page-head dark">
    <div class="tanka"></div>
    <div class="wrap"><h1 class="h2">Gallery</h1></div>
  </section>
  <section class="section dark" style="padding-top:20px">
    <div class="wrap">
      <GalleryGrid items={gallery} />
      <div style="display:flex;justify-content:center;margin-top:48px"><Social /></div>
    </div>
  </section>
</Base>
