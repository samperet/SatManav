---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const themes = [
  { id: 'geometric', label: 'Geometric' },
  { id: 'abstract', label: 'Abstract' },
  { id: 'eastern', label: 'Eastern Traditional' },
];
---
<Base title="Journey" solidHeader>
  <section class="page-head dark">
    <div class="tanka"></div>
    <div class="wrap"><h1 class="h2">Journey</h1></div>
  </section>

  <section class="section dark ember-bg" style="padding-top:30px">
    <div class="wrap" style="max-width:720px">
      <form class="form" data-journey data-email={site.contact.email} action={site.formEndpoint || undefined} method="post" novalidate>
        <fieldset class="field">
          <legend>Name *</legend>
          <div class="two">
            <div class="field"><input id="first" name="first" type="text" autocomplete="given-name" required aria-label="First" /><small>First</small></div>
            <div class="field"><input id="last" name="last" type="text" autocomplete="family-name" required aria-label="Last" /><small>Last</small></div>
          </div>
        </fieldset>
        <div class="field">
          <label for="email">Email *</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="phone">Phone</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" />
        </div>
        <div class="field">
          <label for="intention">What is your intention for our work together?</label>
          <textarea id="intention" name="intention"></textarea>
        </div>

        <fieldset class="field">
          <legend>As we build a style language, rate any themes you want to incorporate:</legend>
          {themes.map((t) => (
            <div class="rating">
              <span>{t.label}</span>
              <div class="stars" role="radiogroup" aria-label={t.label}>
                {[5, 4, 3, 2, 1].map((n) => (
                  <>
                    <input type="radio" id={`${t.id}-${n}`} name={t.id} value={n} />
                    <label for={`${t.id}-${n}`}><span class="sr-only">Rate {n} out of 5</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z" fill="currentColor" /></svg></label>
                  </>
                ))}
              </div>
            </div>
          ))}
        </fieldset>

        <div class="field">
          <label for="message">Anything else you want to add?</label>
          <small>Keep in mind that we will have time to discuss in person, and go on a journey together. This form is simply a place to start.</small>
          <textarea id="message" name="message" aria-label="Message" placeholder="Message"></textarea>
        </div>

        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
        <div class="form-status" data-status role="status" aria-live="polite"></div>
        <div><button class="btn" type="submit" data-submit>Submit</button></div>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-journey]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const say = (msg: string) => { status.textContent = msg; status.classList.add('show'); };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const missing = [...form.querySelectorAll<HTMLInputElement>('[required]')].find(
      (f) => !f.value.trim() || (f.type === 'email' && !/^\S+@\S+\.\S+$/.test(f.value)),
    );
    if (missing) {
      missing.focus();
      say('This field is required.');
      return;
    }
    const data = Object.fromEntries(new FormData(form) as any) as Record<string, string>;
    if (data._gotcha) return;
    const endpoint = form.getAttribute('action');
    if (endpoint) {
      try {
        const res = await fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json', 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        if (!res.ok) throw new Error(String(res.status));
        say('Thank you.');
        form.reset();
        return;
      } catch {
        /* fall through to email */
      }
    }
    const body = [
      `Name: ${data.first} ${data.last}`,
      `Email: ${data.email}`,
      `Phone: ${data.phone ?? ''}`,
      '',
      `What is your intention for our work together?\n${data.intention ?? ''}`,
      '',
      `Geometric: ${data.geometric ?? '-'} / 5`,
      `Abstract: ${data.abstract ?? '-'} / 5`,
      `Eastern Traditional: ${data.eastern ?? '-'} / 5`,
      '',
      `Anything else you want to add?\n${data.message ?? ''}`,
    ].join('\n');
    window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Journey: ${data.first} ${data.last}`)}&body=${encodeURIComponent(body)}`;
  });
</script>
