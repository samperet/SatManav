---
import Admin from '../../layouts/Admin.astro';
import { adminConfigured, checkPassword, createSession, isAdmin, SESSION_COOKIE, SESSION_DAYS } from '../../lib/server/auth';

export const prerender = false;

if (await isAdmin(Astro.cookies.get(SESSION_COOKIE)?.value)) return Astro.redirect('/admin');

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (await checkPassword(String(form.get('password') ?? ''))) {
    Astro.cookies.set(SESSION_COOKIE, await createSession(), {
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: 'strict',
      path: '/',
      maxAge: SESSION_DAYS * 86400,
    });
    return Astro.redirect('/admin', 303);
  }
  await new Promise((r) => setTimeout(r, 800)); // slow down password guessing
  error = adminConfigured() ? 'That password is not correct.' : 'Admin is not set up yet: add ADMIN_PASSWORD in Vercel.';
  Astro.response.status = 401;
}
---
<Admin title="Sign in">
  <form class="a-login" method="post">
    <h1>Sign in</h1>
    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required autofocus />
    {error && <p class="a-error" role="alert">{error}</p>}
    <button class="a-btn" type="submit">Sign in</button>
  </form>
</Admin>
