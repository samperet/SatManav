---
import Admin from '../../layouts/Admin.astro';
import Columns from '../../components/admin/Columns.astro';
import type { Point } from '../../components/admin/chart-types';
import Ranked from '../../components/admin/Ranked.astro';
import Notify from '../../components/admin/Notify.astro';
import { isAdmin, SESSION_COOKIE } from '../../lib/server/auth';
import { dbConfigured, query } from '../../lib/server/db';
import { adminStats, type Stats } from '../../lib/server/stats';

export const prerender = false;

if (!(await isAdmin(Astro.cookies.get(SESSION_COOKIE)?.value))) return Astro.redirect('/admin/login');
Astro.response.headers.set('Cache-Control', 'no-store');

const RANGES = [
  { days: 7, label: 'Last 7 days' },
  { days: 30, label: 'Last 30 days' },
  { days: 90, label: 'Last 90 days' },
  { days: 365, label: 'Last 12 months' },
];
const days = RANGES.some((r) => r.days === Number(Astro.url.searchParams.get('days'))) ? Number(Astro.url.searchParams.get('days')) : 30;
const TZ = 'America/New_York';

type Row = { name: string; [k: string]: string | number };
type Lead = {
  id: string; created_at: string | Date; email: string; stage: 'email' | 'details'; status: string;
  first_name: string | null; last_name: string | null; phone: string | null; intention: string | null;
  geometric: number | null; abstract: number | null; eastern: number | null; message: string | null; photos: string[];
  source: string | null; medium: string | null; referrer_host: string | null; landing_path: string | null; utm_campaign: string | null;
  city: string | null; region: string | null; country: string | null; device: string | null;
};
type Testimonial = { id: string; created_at: string | Date; name: string; email: string | null; body: string; consent: boolean; status: 'pending' | 'approved' | 'rejected' };

const configured = dbConfigured();
let testimonials: Testimonial[] = [];
let stats: Stats | null = null;
let leads: Lead[] = [];
let loadError = '';

if (configured) {
  try {
    // The moderation queue is not limited by the date range: pending items must never hide.
    testimonials = await query<Testimonial>('select id, created_at, name, email, body, consent, status from testimonials order by created_at desc limit 300');
    stats = await adminStats(days, TZ);
    leads = await query<Lead>('select * from leads where created_at >= $1 order by created_at desc limit 500', [stats.since]);
  } catch (err) {
    console.error('[admin]', err);
    loadError = err instanceof Error ? err.message : String(err);
  }
}
// Private photos are streamed through an admin-only route.
const photoUrl = (path: string) => `/api/admin/photo?p=${encodeURIComponent(path)}`;

// ---------- formatting ----------
const num = (n: number) => n.toLocaleString('en-US');
const pct = (a: number, b: number) => {
  if (!(b > 0)) return '–';
  const r = (a / b) * 100;
  return r.toFixed(r >= 10 || r === 0 ? 0 : 1) + '%';
};
const delta = (cur: number, prev: number) => {
  if (!prev) return cur ? { text: 'new', dir: 'up' } : null;
  const d = Math.round(((cur - prev) / prev) * 100);
  return { text: `${d > 0 ? '+' : ''}${d}%`, dir: d > 0 ? 'up' : d < 0 ? 'down' : 'flat' };
};
const dayLabel = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const when = (d: string | Date) => new Date(d).toLocaleString('en-US', { timeZone: TZ, month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
const STATUS: Record<string, string> = { new: 'New', contacted: 'Contacted', booked: 'Booked', archived: 'Archived' };

// Daily series (weekly buckets for the 12-month view so columns stay readable)
function bucket(rows: Stats['daily'], pick: (r: Stats['daily'][number]) => number[]): Point[] {
  if (days <= 90) return rows.map((r) => ({ label: dayLabel(r.day), values: pick(r) }));
  const out: Point[] = [];
  for (let i = 0; i < rows.length; i += 7) {
    const chunk = rows.slice(i, i + 7);
    const sums = chunk.map(pick).reduce((a, b) => a.map((v, k) => v + b[k]));
    out.push({ label: `Week of ${dayLabel(chunk[0].day)}`, values: sums });
  }
  return out;
}
const visitorsPts = stats ? bucket(stats.daily, (r) => [r.visitors]) : [];
const leadsPts = stats ? bucket(stats.daily, (r) => [r.leads_email, r.leads_details]) : [];
const rows = (list: Row[] | undefined, key: string) => (list ?? []).map((r) => ({ name: String(r.name), value: Number(r[key]) }));
const sourceMax = stats ? Math.max(1, ...stats.sources.map((s) => s.visits)) : 1;
const t = stats?.totals;
const p = stats?.previous;
const kpis = t && p ? [
  { label: 'Visitors', value: num(t.visitors), d: delta(t.visitors, p.visitors) },
  { label: 'Page views', value: num(t.pageviews), d: delta(t.pageviews, p.pageviews) },
  { label: 'Leads', value: num(t.leads), d: delta(t.leads, p.leads), sub: 'emails captured' },
  { label: 'Completed journeys', value: num(t.completed), d: delta(t.completed, p.completed), sub: `${pct(t.completed, t.leads)} of leads` },
  { label: 'Lead conversion', value: pct(t.leads, t.visitors), sub: 'leads ÷ visitors' },
] : [];
const rangeLabel = RANGES.find((r) => r.days === days)!.label.toLowerCase();
const T_STATUS = [
  { key: 'pending', label: 'Pending' },
  { key: 'approved', label: 'Approved' },
  { key: 'rejected', label: 'Rejected' },
] as const;
const tCount = (k: string) => testimonials.filter((x) => x.status === k).length;

// Form submissions: finished journeys are shown in full; email-only leads as a compact list.
const completed = leads.filter((l) => l.stage === 'details');
const emailOnly = leads.filter((l) => l.stage !== 'details');
const newCount = leads.filter((l) => l.status === 'new').length;
const leadName = (l: Lead) => [l.first_name, l.last_name].filter(Boolean).join(' ');
const leadWhere = (l: Lead) => [l.city, l.region, l.country].filter(Boolean).join(', ');
const leadText = (l: Lead) => [leadName(l), l.email, l.phone, l.intention, l.message, l.source].filter(Boolean).join(' ').toLowerCase();
const leadRatings = (l: Lead) =>
  ([['Geometric', l.geometric], ['Abstract', l.abstract], ['Eastern Traditional', l.eastern]] as [string, number | null][]).filter(
    (r): r is [string, number] => !!r[1],
  );
const leadSource = (l: Lead) =>
  [l.source ?? 'Direct', l.medium, l.utm_campaign && `campaign: ${l.utm_campaign}`, l.referrer_host && `via ${l.referrer_host}`].filter(Boolean).join(' · ');
const replyHref = (l: Lead) => `mailto:${l.email}?subject=${encodeURIComponent('Your Sat Manav journey')}`;
const pendingCount = tCount('pending');
---
<Admin title="Dashboard" signedIn>
  <div class="filters" role="group" aria-label="Date range">
    {RANGES.map((r) => (
      <a href={`/admin?days=${r.days}`} aria-current={r.days === days ? 'true' : undefined}>{r.label}</a>
    ))}
    <a class="a-btn a-btn--ghost" href={`/api/admin/leads.csv?days=${days}`} download>Export leads (CSV)</a>
  </div>

  {!configured && (
    <section class="card setup">
      <h2>Finish setup</h2>
      <p>The dashboard needs a database. In Vercel, open the project's <strong>Storage</strong> tab → <strong>Create Database</strong> → <strong>Neon (Postgres)</strong>, connect it to this project, then redeploy. Tables are created automatically.</p>
    </section>
  )}
  {loadError && <p class="a-error" role="alert">Could not load data: {loadError}</p>}

  {stats && (
    <section class="card responses" id="leads" aria-labelledby="leads-title">
      <div class="leads-head">
        <div>
          <h2 class="responses__title" id="leads-title">Form submissions <span class="count">{leads.length}</span></h2>
          <p class="card__sub">
            {completed.length} completed · {emailOnly.length} email only{newCount > 0 && <> · <strong class="new-count">{newCount} new</strong></>} · {rangeLabel}
          </p>
        </div>
        <div class="leads-tools">
          <input type="search" placeholder="Search name, email, answers…" aria-label="Search submissions" data-lead-search />
          <select aria-label="Filter by status" data-lead-filter>
            <option value="">All statuses</option>
            {Object.entries(STATUS).map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
        </div>
      </div>

      {leads.length === 0 && <p class="empty">No submissions in the {rangeLabel}.</p>}

      {completed.length > 0 && (
        <div class="responses__grid">
          {completed.map((l) => {
            const name = leadName(l);
            const where = leadWhere(l);
            const ratings = leadRatings(l);
            return (
              <article class={`lead response${l.status === 'new' ? ' is-new' : ''}`} data-status={l.status} data-text={leadText(l)}>
                <header class="response__head">
                  <div class="response__who">
                    <h3>{name || l.email}</h3>
                    <p class="response__contact">
                      <a href={`mailto:${l.email}`}>{l.email}</a>
                      {l.phone && <a href={`tel:${l.phone}`}>{l.phone}</a>}
                    </p>
                  </div>
                  <span class={`chip chip--status chip--${l.status}`} data-status-chip>{STATUS[l.status]}</span>
                </header>
                <p class="response__meta">{when(l.created_at)} · {l.source ?? 'Direct'}{where && ` · ${where}`}</p>

                {l.intention && (
                  <div class="answer">
                    <h4>What is your intention for our work together?</h4>
                    <blockquote class="pre">{l.intention}</blockquote>
                  </div>
                )}
                {ratings.length > 0 && (
                  <div class="answer">
                    <h4>Themes to incorporate</h4>
                    <ul class="ratings">
                      {ratings.map(([k, v]) => (
                        <li>
                          <span class="ratings__name">{k}</span>
                          <span class="stars" role="img" aria-label={`${v} out of 5`}>
                            {[1, 2, 3, 4, 5].map((n) => <i class={n <= v ? 'on' : undefined} aria-hidden="true">★</i>)}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {l.message && (
                  <div class="answer">
                    <h4>Anything else you want to add?</h4>
                    <p class="pre">{l.message}</p>
                  </div>
                )}
                {l.photos?.length > 0 && (
                  <div class="answer">
                    <h4>Inspirational photos <span class="count">{l.photos.length}</span></h4>
                    <ul class="photos">
                      {l.photos.map((path, i) => (
                        <li><a href={photoUrl(path)} target="_blank" rel="noopener"><img src={photoUrl(path)} alt={`Inspirational photo ${i + 1} from ${name || l.email}`} loading="lazy" /></a></li>
                      ))}
                    </ul>
                  </div>
                )}
                {!l.intention && ratings.length === 0 && !l.message && !(l.photos?.length > 0) && <p class="empty">No answers beyond contact details.</p>}

                <details class="response__src">
                  <summary>Where they came from</summary>
                  <p>{leadSource(l)}{l.landing_path && ` · landed on ${l.landing_path}`}{l.device && ` · ${l.device}`}</p>
                </details>

                <footer class="lead__actions">
                  <a class="a-btn" href={replyHref(l)}>Reply by email</a>
                  <label>Status
                    <select data-lead-status={l.id}>
                      {Object.entries(STATUS).map(([v, lab]) => <option value={v} selected={v === l.status}>{lab}</option>)}
                    </select>
                  </label>
                </footer>
              </article>
            );
          })}
        </div>
      )}

      {emailOnly.length > 0 && (
        <div class="email-only">
          <h3 class="email-only__title">Email only <span class="count">{emailOnly.length}</span></h3>
          <p class="card__sub">They left an email but haven't filled in the rest of the form yet.</p>
          <ul class="email-only__list">
            {emailOnly.map((l) => (
              <li class={`lead email-lead${l.status === 'new' ? ' is-new' : ''}`} data-status={l.status} data-text={leadText(l)}>
                <a class="email-lead__addr" href={`mailto:${l.email}`}>{l.email}</a>
                <span class="email-lead__meta">{when(l.created_at)} · {l.source ?? 'Direct'}</span>
                <span class={`chip chip--status chip--${l.status}`} data-status-chip>{STATUS[l.status]}</span>
                <span class="lead__actions">
                  <a class="a-btn a-btn--ghost" href={replyHref(l)}>Reply</a>
                  <label><span class="sr-only">Status for {l.email}</span>
                    <select data-lead-status={l.id}>
                      {Object.entries(STATUS).map(([v, lab]) => <option value={v} selected={v === l.status}>{lab}</option>)}
                    </select>
                  </label>
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}
      <p class="empty" hidden data-lead-none>No submissions match.</p>
    </section>
  )}

  {pendingCount > 0 && (
    <a class="callout" href="#testimonials">{pendingCount} testimonial{pendingCount === 1 ? '' : 's'} awaiting approval →</a>
  )}

  {configured && <Notify />}

  {stats && (
    <>
      <section class="kpis" aria-label="Summary">
        {kpis.map((k) => (
          <div class="kpi">
            <span class="kpi__label">{k.label}</span>
            <span class="kpi__value">{k.value}</span>
            <span class="kpi__meta">
              {k.d && <span class={`delta delta--${k.d.dir}`}>{k.d.dir === 'up' ? '▲' : k.d.dir === 'down' ? '▼' : '•'} {k.d.text}</span>}
              {k.d && ' vs previous period'}
              {!k.d && k.sub}
              {k.d && k.sub && <><br />{k.sub}</>}
            </span>
          </div>
        ))}
      </section>

      <section class="grid-2">
        <div class="card"><Columns title="Visitors" series={[{ name: 'Visitors', color: 'var(--series-1)' }]} points={visitorsPts} /></div>
        <div class="card"><Columns title="Leads" series={[{ name: 'Email only', color: 'var(--series-2)' }, { name: 'Completed', color: 'var(--series-3)' }]} points={leadsPts} /></div>
      </section>

      <section class="card">
        <h2 class="card__title">Where traffic comes from</h2>
        <p class="card__sub">Visits are arrivals from outside the site. Leads are credited to the source the visitor arrived from.</p>
        {stats.sources.length === 0 ? <p class="empty">No visits yet</p> : (
          <div class="table-wrap">
            <table class="sources">
              <thead><tr><th>Source</th><th class="w-bar">Visits</th><th class="num">Leads</th><th class="num">Completed</th><th class="num">Conversion</th></tr></thead>
              <tbody>
                {stats.sources.map((s) => (
                  <tr>
                    <td>{s.source}</td>
                    <td class="w-bar"><span class="inline-bar" style={`width:${(s.visits / sourceMax) * 100}%`}></span><span class="num">{num(s.visits)}</span></td>
                    <td class="num">{num(s.leads)}</td>
                    <td class="num">{num(s.completed)}</td>
                    <td class="num">{pct(s.leads, s.visits)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <p class="hint">Tip: tag links you share with <code>?src=</code>, e.g. <code>satmanavyogitattoos.com/journey?src=instagram</code> for the Instagram bio, or <code>?src=card</code> on business cards. They show up here by name.</p>
      </section>

      <section class="grid-3">
        <Ranked title="Referring sites" rows={rows(stats.referrers, 'visits')} unit="visits" />
        <Ranked title="Landing pages" rows={rows(stats.landing, 'visits')} unit="visits" />
        <Ranked title="Top pages" rows={rows(stats.pages, 'views')} unit="views" />
        <Ranked title="Countries" rows={rows(stats.countries, 'visitors')} unit="visitors" />
        <Ranked title="Cities" rows={rows(stats.cities, 'visitors')} unit="visitors" />
        <Ranked title="Devices" rows={rows(stats.devices, 'visitors')} unit="visitors" />
        <Ranked title="Browsers" rows={rows(stats.browsers, 'visitors')} unit="visitors" />
        <Ranked title="Campaigns (utm_campaign)" rows={rows(stats.campaigns, 'visits')} unit="visits" />
      </section>

    </>
  )}
  {configured && (
    <section class="card" id="testimonials">
      <div class="leads-head">
        <h2 class="card__title">Testimonials</h2>
        <div class="tabs" role="tablist" aria-label="Testimonial status">
          {T_STATUS.map((st, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-t-tab={st.key}>
              {st.label} <span class="count" data-t-count={st.key}>{tCount(st.key)}</span>
            </button>
          ))}
        </div>
      </div>
      <p class="card__sub">Submitted from the Testimonials section of the homepage. Only approved ones appear on the site (within about a minute). You can tidy the wording before approving.</p>
      {T_STATUS.map((st, i) => (
        <div class="tlist" data-t-panel={st.key} hidden={i !== 0}>
          {tCount(st.key) === 0 && <p class="empty">Nothing {st.label.toLowerCase()}.</p>}
          {testimonials.filter((x) => x.status === st.key).map((x) => (
            <article class="tcard" data-t-id={x.id}>
              <div class="tcard__meta">
                <span>{when(x.created_at)}</span>
                {x.email && <a href={`mailto:${x.email}`}>{x.email}</a>}
                <span>{x.consent ? 'Permission to publish: yes' : 'No permission to publish'}</span>
              </div>
              <label class="sr-only" for={`tn-${x.id}`}>Name</label>
              <input class="tcard__name" id={`tn-${x.id}`} value={x.name} maxlength="80" data-t-name />
              <label class="sr-only" for={`tb-${x.id}`}>Testimonial</label>
              <textarea class="tcard__body" id={`tb-${x.id}`} rows="5" maxlength="3000" data-t-body>{x.body}</textarea>
              <div class="tcard__actions">
                {x.status !== 'approved' && <button type="button" class="a-btn" data-t-action="approve" disabled={!x.consent}>Approve &amp; publish</button>}
                {x.status === 'approved' && <button type="button" class="a-btn" data-t-action="save">Save changes</button>}
                {x.status === 'approved' && <button type="button" class="a-btn a-btn--ghost" data-t-action="unpublish">Unpublish</button>}
                {x.status === 'pending' && <button type="button" class="a-btn a-btn--ghost" data-t-action="reject">Reject</button>}
                <button type="button" class="a-btn a-btn--ghost a-btn--danger" data-t-action="delete">Delete</button>
                <span class="tcard__msg" role="status" aria-live="polite"></span>
              </div>
            </article>
          ))}
        </div>
      ))}
    </section>
  )}
  <div class="tip" role="tooltip" hidden data-tip-el></div>
</Admin>

<script>
  /* Column tooltips: hover or keyboard focus. Text is set with textContent. */
  const tip = document.querySelector<HTMLElement>('[data-tip-el]')!;
  const show = (col: HTMLElement, x: number, y: number) => {
    const d = JSON.parse(col.dataset.tip!) as { t: string; r: [string, number, string][] };
    const title = document.createElement('div');
    title.className = 'tip__title';
    title.textContent = d.t;
    const rows = d.r.map(([name, v, color]) => {
      const row = document.createElement('div');
      row.className = 'tip__row';
      const key = document.createElement('i');
      key.style.background = color;
      const val = document.createElement('strong');
      val.textContent = String(v);
      const lab = document.createElement('span');
      lab.textContent = name;
      row.append(key, val, lab);
      return row;
    });
    tip.replaceChildren(title, ...rows);
    tip.hidden = false;
    const r = tip.getBoundingClientRect();
    tip.style.left = `${Math.min(window.innerWidth - r.width - 8, Math.max(8, x - r.width / 2))}px`;
    tip.style.top = `${Math.max(8, y - r.height - 12)}px`;
    document.querySelectorAll('.col.is-hot').forEach((c) => c.classList.remove('is-hot'));
    col.classList.add('is-hot');
  };
  const hide = () => {
    tip.hidden = true;
    document.querySelectorAll('.col.is-hot').forEach((c) => c.classList.remove('is-hot'));
  };
  document.querySelectorAll<HTMLElement>('.col').forEach((col) => {
    col.addEventListener('pointermove', (e) => show(col, e.clientX, col.getBoundingClientRect().top));
    col.addEventListener('pointerleave', hide);
    col.addEventListener('focus', () => {
      const r = col.getBoundingClientRect();
      show(col, r.left + r.width / 2, r.top);
    });
    col.addEventListener('blur', hide);
  });

  /* Lead status changes save immediately */
  document.querySelectorAll<HTMLSelectElement>('[data-lead-status]').forEach((sel) => {
    let prev = sel.value;
    sel.addEventListener('change', async () => {
      sel.disabled = true;
      const res = await fetch('/api/admin/lead-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: sel.dataset.leadStatus, status: sel.value }),
      }).catch(() => null);
      sel.disabled = false;
      if (!res?.ok) {
        sel.value = prev;
        alert('Could not save the status. Please try again.');
        return;
      }
      prev = sel.value;
      const lead = sel.closest<HTMLElement>('.lead')!;
      lead.dataset.status = sel.value;
      lead.classList.toggle('is-new', sel.value === 'new');
      const chip = lead.querySelector<HTMLElement>('[data-status-chip]')!;
      chip.textContent = sel.selectedOptions[0].textContent;
      chip.className = `chip chip--status chip--${sel.value}`;
    });
  });

  /* Testimonial tabs */
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-t-tab]');
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      document.querySelectorAll<HTMLElement>('[data-t-panel]').forEach((p) => (p.hidden = p.dataset.tPanel !== tab.dataset.tTab));
    }),
  );

  /* Testimonial moderation */
  document.querySelectorAll<HTMLButtonElement>('[data-t-action]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      const card = btn.closest<HTMLElement>('[data-t-id]')!;
      const action = btn.dataset.tAction!;
      if (action === 'delete' && !confirm('Delete this testimonial permanently?')) return;
      const msg = card.querySelector<HTMLElement>('.tcard__msg')!;
      card.querySelectorAll('button').forEach((b) => (b.disabled = true));
      msg.textContent = 'Saving…';
      const res = await fetch('/api/admin/testimonial', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: card.dataset.tId,
          action,
          name: card.querySelector<HTMLInputElement>('[data-t-name]')!.value,
          body: card.querySelector<HTMLTextAreaElement>('[data-t-body]')!.value,
        }),
      }).catch(() => null);
      if (!res?.ok) {
        msg.textContent = 'Could not save. Please try again.';
        card.querySelectorAll('button').forEach((b) => (b.disabled = false));
        return;
      }
      if (action === 'save') {
        msg.textContent = 'Saved.';
        card.querySelectorAll('button').forEach((b) => (b.disabled = false));
        return;
      }
      // Status changed: reload to move the card to its new tab, keeping the position.
      location.hash = 'testimonials';
      location.reload();
    }),
  );

  /* Search + status filter */
  const search = document.querySelector<HTMLInputElement>('[data-lead-search]');
  const filter = document.querySelector<HTMLSelectElement>('[data-lead-filter]');
  const apply = () => {
    const q = (search?.value ?? '').trim().toLowerCase();
    const st = filter?.value ?? '';
    let shown = 0;
    document.querySelectorAll<HTMLElement>('.lead').forEach((l) => {
      l.hidden = (q !== '' && !l.dataset.text!.includes(q)) || (st !== '' && l.dataset.status !== st);
      if (!l.hidden) shown++;
    });
    // Hide a group's heading when none of its entries match.
    document.querySelectorAll<HTMLElement>('.responses__grid, .email-only').forEach((g) => {
      g.hidden = !g.querySelector('.lead:not([hidden])');
    });
    const none = document.querySelector<HTMLElement>('[data-lead-none]');
    if (none) none.hidden = shown > 0 || document.querySelectorAll('.lead').length === 0;
  };
  search?.addEventListener('input', apply);
  filter?.addEventListener('change', apply);
</script>
