---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, site } from '../../data/site';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props;
const related = products.filter((x) => x.slug !== p.slug).slice(0, 3);
---
<Base title={p.name} image={p.images[0].src} solidHeader>
  <section class="section paper" style="padding-top:130px">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/shop">Shop</a> / {p.name}</nav>
      <div class="pdp">
        <div>
          <div class="pdp__main"><img src={p.images[0].src} alt={p.images[0].alt} data-pdp-main width="800" height="1000" /></div>
          {p.images.length > 1 && (
            <div class="thumbs">
              {p.images.map((im, i) => (
                <button type="button" data-thumb={im.src} data-alt={im.alt} aria-current={i === 0 ? 'true' : 'false'} aria-label={im.alt}>
                  <img src={im.src} alt="" loading="lazy" width="74" height="74" />
                </button>
              ))}
            </div>
          )}
        </div>
        <div>
          <h1>{p.name}</h1>
          <span class="price">${p.price.toFixed(2)}</span>
          <div class="buy-row" data-buy data-name={p.name} data-price={p.price} data-checkout={p.checkoutUrl ?? ''} data-email={site.contact.email}>
            <div class="qty">
              <button type="button" data-qty="-1" aria-label="Decrease quantity">−</button>
              <output data-qty-out aria-live="polite">1</output>
              <button type="button" data-qty="1" aria-label="Increase quantity">+</button>
            </div>
            <a class="btn" href="#" data-buy-btn>Buy</a>
          </div>
        </div>
      </div>

      <h2 class="title" style="font-size:1.5rem;color:var(--maroon-2);margin:90px 0 22px">Related products</h2>
      <div class="products">
        {related.map((o) => <ProductCard product={o} />)}
      </div>
    </div>
  </section>
</Base>

<script>
  const main = document.querySelector<HTMLImageElement>('[data-pdp-main]');
  document.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((b, _, all) =>
    b.addEventListener('click', () => {
      if (!main) return;
      main.src = b.dataset.thumb!;
      main.alt = b.dataset.alt ?? '';
      all.forEach((x) => x.setAttribute('aria-current', String(x === b)));
    }),
  );
  const row = document.querySelector<HTMLElement>('[data-buy]');
  if (row) {
    let qty = 1;
    const out = row.querySelector('[data-qty-out]')!;
    const btn = row.querySelector<HTMLAnchorElement>('[data-buy-btn]')!;
    const { name, price, checkout, email } = row.dataset;
    const update = () => {
      out.textContent = String(qty);
      if (checkout) {
        btn.href = checkout;
        btn.target = '_blank';
        btn.rel = 'noopener';
      } else {
        const body = `${qty} × ${name} ($${(Number(price) * qty).toFixed(2)})`;
        btn.href = `mailto:${email}?subject=${encodeURIComponent(name ?? '')}&body=${encodeURIComponent(body)}`;
      }
    };
    row.querySelectorAll<HTMLButtonElement>('[data-qty]').forEach((b) =>
      b.addEventListener('click', () => {
        qty = Math.max(1, Math.min(20, qty + Number(b.dataset.qty)));
        update();
      }),
    );
    update();
  }
</script>
