---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import ProductCard from '../components/ProductCard.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { intro, artist, teachings, testimonials, products, offerings, gallery } from '../data/site';

const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero__ganesha" src="/images/brand/ganesha.webp" alt="" width="513" height="769" fetchpriority="high" />
    <div class="wrap hero__inner">
      <h1 id="hero-title">
        <span class="hero__word">Sat Manav</span>
        <span class="hero__sub">Tattoos &amp; Talismans</span>
      </h1>
      <div class="hero__ctas">
        <a class="btn" href="/journey">Begin Your Spiritual Journey</a>
        <a class="btn btn--ghost" href="/gallery">Gallery</a>
      </div>
    </div>
  </section>

  <Ticker />

  <section class="section dark ember-bg">
    <div class="wrap split">
      <div>
        <h2 class="h2">{intro.title}</h2>
        <p class="lead">{intro.text}</p>
      </div>
      <img class="lotus" src="/images/brand/lotus-white.webp" alt="Sat Manav lotus emblem" width="400" height="409" />
    </div>

    <div class="wrap split split--rev" style="margin-top:clamp(64px,8vw,120px)">
      <div>
        <h2 class="h2">{artist.name}</h2>
        <p>{artist.text}</p>
      </div>
      <img class="artist-photo" src="/images/brand/shug.webp" alt={artist.name} width="400" height="518" loading="lazy" />
    </div>
  </section>

  <section class="section paper">
    <div class="wrap teachings">
      {teachings.map((t, i) => (
        <details class="teaching">
          <summary>
            <span class="teaching__num" aria-hidden="true">{roman[i]}</span>
            <h3>{t.title}</h3>
            <svg class="teaching__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </summary>
          <div class="teaching__body">
            {t.body.map((p) => <p>{p}</p>)}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section id="gallery" class="section dark">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:32px"><a href="/gallery" style="text-decoration:none">Gallery</a></h2>
      <GalleryGrid items={gallery} />
      <p style="text-align:center;margin-top:28px"><a class="link-arrow" href="/gallery">See the full gallery →</a></p>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap">
      <div class="section-head center">
        <h2 class="h2">Sat Manav Store</h2>
        <p class="title" style="color:var(--blood);font-size:1.2rem;margin-top:8px">Sacred Art &amp; Merchandise for Purchase</p>
      </div>
      <div class="products">
        {products.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="section paper" style="padding-top:0">
    <div class="wrap">
      <div class="section-head center">
        <img src="/images/brand/om.webp" alt="" width="120" height="112" style="width:90px;margin:0 auto 18px" loading="lazy" />
        <h2 class="h2">Testimonials</h2>
      </div>
      <div class="quotes">
        {testimonials.map((t) => (
          <blockquote class="quote">
            {t.paragraphs.map((p) => <p>{p}</p>)}
            <cite>— {t.name}</cite>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="section dark ember-bg">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:40px">Additional Offerings</h2>
      <div class="offerings">
        {offerings.map((o) => (
          <article class="offer">
            <h3>{o.title}</h3>
            {o.text.map((p) => <p>{p}</p>)}
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
