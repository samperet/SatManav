---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { intro, artist, teachings, testimonials, offerings, gallery } from '../data/site';

const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero__ganesha" src="/images/brand/ganesha.webp" alt="" width="513" height="769" fetchpriority="high" />
    <div class="wrap hero__inner">
      <h1 id="hero-title">
        <span class="hero__word">Sat Manav</span>
        <span class="hero__sub">Tattoos &amp; Talismans</span>
      </h1>
      <div class="hero__ctas">
        <a class="btn" href="/journey">Begin Your Spiritual Journey</a>
        <a class="btn btn--ghost" href="/gallery">Gallery</a>
      </div>
    </div>
  </section>

  <Ticker />

  <section class="section dark ember-bg">
    <div class="wrap split">
      <div>
        <h2 class="h2">{intro.title}</h2>
        <p class="lead">{intro.text}</p>
      </div>
      <img class="lotus" src="/images/brand/lotus-white.webp" alt="Sat Manav lotus emblem" width="400" height="409" />
    </div>

    <div class="wrap split split--rev" style="margin-top:clamp(64px,8vw,120px)">
      <div>
        <h2 class="h2">{artist.name}</h2>
        <p>{artist.text}</p>
      </div>
      <img class="artist-photo" src="/images/brand/shug.webp" alt={artist.name} width="400" height="518" loading="lazy" />
    </div>
  </section>

  <section class="section paper">
    <div class="wrap teachings">
      {teachings.map((t, i) => (
        <details class="teaching">
          <summary>
            <span class="teaching__num" aria-hidden="true">{roman[i]}</span>
            <h3>{t.title}</h3>
            <svg class="teaching__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </summary>
          <div class="teaching__body">
            {t.body.map((p) => <p>{p}</p>)}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section id="gallery" class="section dark">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:32px"><a href="/gallery" style="text-decoration:none">Gallery</a></h2>
      <GalleryGrid items={gallery} />
      <p style="text-align:center;margin-top:28px"><a class="link-arrow" href="/gallery">See the full gallery →</a></p>
    </div>
  </section>

  <section class="section paper" id="testimonials">
    <div class="wrap">
      <div class="section-head center">
        <img src="/images/brand/om.webp" alt="" width="120" height="112" style="width:90px;margin:0 auto 18px" loading="lazy" />
        <h2 class="h2">Testimonials</h2>
      </div>
      <div class="quotes" data-quotes>
        {testimonials.map((t) => (
          <blockquote class="quote">
            {t.paragraphs.map((p) => <p>{p}</p>)}
            <cite>— {t.name}</cite>
          </blockquote>
        ))}
      </div>

      <details class="share">
        <summary class="btn">Share your experience</summary>
        <form class="share__form" data-share novalidate>
          <div class="share__row">
            <div class="share__field">
              <label for="t-name">Name *</label>
              <input id="t-name" name="name" type="text" autocomplete="name" maxlength="80" required />
            </div>
            <div class="share__field">
              <label for="t-email">Email <small>(not published)</small></label>
              <input id="t-email" name="email" type="email" autocomplete="email" />
            </div>
          </div>
          <div class="share__field">
            <label for="t-body">Testimonial *</label>
            <textarea id="t-body" name="body" rows="6" maxlength="3000" required></textarea>
          </div>
          <label class="share__consent"><input type="checkbox" name="consent" required /> I give permission to publish this on the site.</label>
          <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <p class="share__status" role="status" aria-live="polite" data-share-status></p>
          <button class="btn" type="submit">Submit</button>
        </form>
      </details>
    </div>
  </section>

  <section class="section dark ember-bg">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:40px">Additional Offerings</h2>
      <div class="offerings">
        {offerings.map((o) => (
          <article class="offer">
            <h3>{o.title}</h3>
            {o.text.map((p) => <p>{p}</p>)}
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  // Approved testimonials submitted through the site (newest first), added before the originals.
  const quotes = document.querySelector<HTMLElement>('[data-quotes]');
  fetch('/api/testimonial')
    .then((r) => (r.ok ? r.json() : []))
    .then((list: { name: string; body: string }[]) => {
      if (!quotes || !Array.isArray(list)) return;
      const nodes = list.map((t) => {
        const q = document.createElement('blockquote');
        q.className = 'quote';
        t.body.split(/\n{2,}/).forEach((para) => {
          const p = document.createElement('p');
          p.textContent = para.trim();
          q.append(p);
        });
        const cite = document.createElement('cite');
        cite.textContent = `— ${t.name}`;
        q.append(cite);
        return q;
      });
      quotes.prepend(...nodes);
    })
    .catch(() => {});

  // Submit a testimonial for approval
  const form = document.querySelector<HTMLFormElement>('[data-share]');
  const status = document.querySelector<HTMLElement>('[data-share-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const say = (m: string) => { if (status) status.textContent = m; };
    const name = form.querySelector<HTMLInputElement>('#t-name')!;
    const body = form.querySelector<HTMLTextAreaElement>('#t-body')!;
    const consent = form.querySelector<HTMLInputElement>('[name=consent]')!;
    if (!name.value.trim()) { say('Please add your name.'); name.focus(); return; }
    if (body.value.trim().length < 10) { say('Please write a little more.'); body.focus(); return; }
    if (!consent.checked) { say('Please tick the permission box.'); consent.focus(); return; }
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    btn.disabled = true;
    say('');
    try {
      const res = await fetch('/api/testimonial', { method: 'POST', body: new FormData(form) });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.ok) throw new Error(out.error);
      form.reset();
      say('Thank you. Your testimonial will appear here once it has been approved.');
    } catch {
      say('Something went wrong. Please try again.');
    } finally {
      btn.disabled = false;
    }
  });
</script>
