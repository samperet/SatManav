---
import type { Product } from '../data/site';
interface Props { product: Product; }
const { product: p } = Astro.props;
---
<a class="product" href={`/shop/${p.slug}`}>
  <div class="product__img"><img src={p.images[0].src} alt={p.images[0].alt} loading="lazy" width="400" height="500" /></div>
  <h3>{p.name}</h3>
  <span class="price">${p.price.toFixed(2)}</span>
</a>
