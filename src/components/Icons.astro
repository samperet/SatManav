---
interface Props { name: 'arrow' | 'instagram' | 'facebook' | 'phone' | 'mail' | 'pin' | 'petal' | 'yantra' | 'retreat' | 'wood' | 'kirtan'; }
const { name } = Astro.props;
---
{name === 'arrow' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
)}
{name === 'instagram' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>
)}
{name === 'facebook' && (
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z" /></svg>
)}
{name === 'petal' && (
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c3 3.5 4.5 7 4.5 10.5S14.5 20 12 22c-2.5-2-4.5-6-4.5-9.5S9 5.5 12 2z" /></svg>
)}
{name === 'yantra' && (
  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="6" y="6" width="52" height="52" /><circle cx="32" cy="32" r="22" /><g class="spin"><path d="M32 13 50 44H14z" /><path d="M32 51 14 20h36z" /></g><circle cx="32" cy="32" r="2.5" fill="currentColor" /></svg>
)}
{name === 'retreat' && (
  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 50 22 22l10 14 8-10 20 24z" /><circle class="spin" cx="46" cy="14" r="6" stroke-dasharray="3 3" /><path d="M2 56h60" /></svg>
)}
{name === 'wood' && (
  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><g class="spin"><circle cx="32" cy="32" r="24" /><circle cx="32" cy="32" r="17" /><circle cx="32" cy="32" r="10" /><circle cx="32" cy="32" r="4" /></g><path d="M32 8v8M56 32h-8" /></svg>
)}
{name === 'kirtan' && (
  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><ellipse cx="32" cy="36" rx="18" ry="12" /><path d="M14 36c0 6 8 12 18 12s18-6 18-12" /><g class="spin"><path d="M10 14c3 3 3 7 0 10M54 14c-3 3-3 7 0 10M20 8c2 2 2 5 0 7M44 8c-2 2-2 5 0 7" /></g></svg>
)}
