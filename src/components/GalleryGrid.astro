---
import type { GalleryItem } from '../data/site';
interface Props { items: GalleryItem[]; }
const { items } = Astro.props;
---
<div class="masonry">
  {items.map((g) => (
    <button type="button" class="tile" data-lightbox data-full={`/images/gallery/${g.slug}.webp`} data-alt={g.alt} aria-label={g.alt}>
      <img src={`/images/gallery/${g.slug}-sm.webp`} alt={g.alt} width="520" height={Math.round((g.h * 520) / g.w)} loading="lazy" decoding="async" />
    </button>
  ))}
</div>
